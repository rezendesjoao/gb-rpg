{{!--
    Ficha vista por um jogador que não é dono do ator (NPCs e inimigos
    liberados pelo mestre): só a carta do personagem — arte, nome, classe,
    herança, rank e nível.
--}}
<div class="gb-limited-card" data-tooltip-class="gb-tooltip">
    <figure class="gb-portrait gb-portrait--limited gb-frame">
        <img src="{{actor.img}}" alt="{{actor.name}}">
        <div class="gb-portrait-shade"></div>
        {{#if rank.letter}}
        <span class="gb-crest" data-rank="{{rank.letter}}">
            <span class="gb-crest-letter">{{rank.letter}}</span>
            <span class="gb-crest-num">{{rank.number}}</span>
        </span>
        {{/if}}
        <a class="gb-portrait-zoom" data-action="showArtwork" data-tooltip="Ver a arte em tamanho real"><i class="fa-solid fa-expand"></i></a>
        <figcaption class="gb-nameplate">
            <h2 class="gb-name">{{actor.name}}</h2>
            <div class="gb-limited-tags">
                {{#if classLabel}}<span class="gb-chip gb-chip--gold"><i class="fa-solid fa-swords"></i> {{classLabel}}</span>{{/if}}
                {{#if heritageLabel}}<span class="gb-chip gb-chip--gold"><i class="fa-solid fa-dna"></i> {{heritageLabel}}</span>{{/if}}
                {{#if rankLabel}}<span class="gb-chip"><i class="fa-solid fa-medal"></i> Rank <b>{{rankLabel}}</b></span>{{/if}}
                <span class="gb-chip"><i class="fa-solid fa-signal"></i> Nível <b>{{system.level}}</b></span>
            </div>
        </figcaption>
    </figure>
</div>
