{{!--
    RD física e mágica (fixa + bônus + temporária = total) e deslocamento
    (base + bônus). Usado na ficha de personagem e na de adversário.
    A RD da natureza do dano (física ou mágica) é abatida pelo botão de dano do chat.
--}}
<div class="gb-defense-row">
    {{#each rd as |r|}}
    <div class="gb-res-block gb-res-block--rd gb-res-block--rd-{{r.key}}">
        <h4><i class="fa-solid {{#if (eqStr r.key "magical")}}fa-hat-wizard{{else}}fa-shield{{/if}}"></i> {{r.label}}
            <span class="gb-rd-total" title="Total{{#if r.fromEffects}} (com efeitos ativos){{/if}}">{{r.total}}</span>
        </h4>
        <div class="gb-rd-parts">
            <label><span>Fixa</span><input type="number" name="system.defenses.rd.{{r.key}}.fixed" value="{{r.fixed}}" min="0"></label>
            <label><span>Bônus</span><input type="number" name="system.defenses.rd.{{r.key}}.bonus" value="{{r.bonus}}"></label>
            <label><span>Temp.</span><input type="number" name="system.defenses.rd.{{r.key}}.temp" value="{{r.temp}}"></label>
        </div>
    </div>
    {{/each}}
    <div class="gb-res-block gb-res-block--move">
        <h4><i class="fa-solid fa-person-running"></i> Deslocamento
            <span class="gb-rd-total" title="Base + bônus">{{movementLabel}}</span>
        </h4>
        <div class="gb-rd-parts gb-rd-parts--2">
            <label><span>Base (m)</span><input type="text" name="system.movement" value="{{system.movement}}"></label>
            <label><span>Bônus</span><input type="number" name="system.movementBonus" value="{{system.movementBonus}}"></label>
        </div>
    </div>
</div>
