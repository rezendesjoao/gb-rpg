{{!--
    Classe e Herança na placa do nome (personagem e antagonista). Mostra só o
    nome escolhido; o seletor fica invisível por cima e abre ao clicar.
--}}
<label class="gb-pick" data-tooltip="Classe (Estilo de Guerreiro) — clique para trocar">
    <i class="fa-solid fa-swords"></i>
    <span class="gb-pick-value{{#unless classLabel}} is-empty{{/unless}}">{{#if classLabel}}{{classLabel}}{{else}}Classe{{/if}}</span>
    <select data-gb-chooser="class">
        <option value="" {{#if classBlankSelected}}selected{{/if}}>—</option>
        {{#each classGroups as |grp|}}
        <optgroup label="{{grp.label}}">
            {{#each grp.options as |o|}}
            <option value="{{o.value}}" {{#if o.selected}}selected{{/if}}>{{o.label}}</option>
            {{/each}}
        </optgroup>
        {{/each}}
    </select>
</label>
<label class="gb-pick" data-tooltip="Herança — clique para trocar">
    <i class="fa-solid fa-dna"></i>
    <span class="gb-pick-value{{#unless heritageLabel}} is-empty{{/unless}}">{{#if heritageLabel}}{{heritageLabel}}{{else}}Herança{{/if}}</span>
    <select data-gb-chooser="heritage">
        <option value="" {{#if heritageBlankSelected}}selected{{/if}}>—</option>
        {{#each heritageOptions as |o|}}
        <option value="{{o.value}}" {{#if o.selected}}selected{{/if}}>{{o.label}}</option>
        {{/each}}
    </select>
</label>
