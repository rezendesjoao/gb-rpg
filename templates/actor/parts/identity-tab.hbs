{{!-- Aba Classe & Herança (personagem e adversário antagonista): dois cartões de códice --}}
<div class="gb-codex">
    <article class="gb-codex-card gb-codex-card--class gb-frame">
        <header class="gb-codex-head">
            <span class="gb-codex-emblem"><i class="fa-solid fa-swords"></i></span>
            <div class="gb-codex-titles">
                <span class="gb-kicker">Estilo de Guerreiro{{#if classGroupLabel}} · {{classGroupLabel}}{{/if}}</span>
                <h2>{{#if classItem}}{{classItem.name}}{{else}}Sem classe{{/if}}</h2>
            </div>
            {{#if classItem}}
            <div class="gb-tools">
                <a class="gb-icon-btn" data-action="openEmbedded" data-item-id="{{classItem.id}}" data-tooltip="Abrir a classe"><i class="fa-solid fa-up-right-from-square"></i></a>
                <a class="gb-icon-btn gb-icon-btn--danger" data-action="removeEmbedded" data-item-id="{{classItem.id}}" data-tooltip="Remover a classe"><i class="fa-solid fa-trash"></i></a>
            </div>
            {{/if}}
        </header>
        {{#if classItem}}
        <div class="gb-codex-stats">
            <div><b>{{classItem.system.vidaBase}}</b><span>Vida base</span></div>
            <div><b>{{classItem.system.vidaDado}}</b><span>Dado de vida</span></div>
            <div><b>{{classItem.system.danoDado}}</b><span>Dado de dano</span></div>
        </div>
        {{#if classItem.system.manaCondition}}<p class="gb-codex-note gb-codex-note--mana"><i class="fa-solid fa-droplet"></i> {{classItem.system.manaCondition}}</p>{{/if}}
        {{#if classItem.system.weapons}}<p class="gb-codex-note"><i class="fa-solid fa-sword"></i> {{classItem.system.weapons}}</p>{{/if}}
        <h4 class="gb-codex-sub">Habilidades</h4>
        {{#each classAbilities as |ab idx|}}
        <div class="gb-feature">
            <div class="gb-feature-head">
                <strong>{{ab.name}}</strong>
                <span class="gb-tag gb-tag--{{ab.type}}">{{#if (eqStr ab.type "ativa")}}Ativa{{else}}Passiva{{/if}}</span>
                <a class="gb-icon-btn" data-action="postFeature" data-feature="ability" data-index="{{idx}}" data-tooltip="Mostrar no chat o que esta habilidade faz"><i class="fa-solid fa-comment"></i></a>
            </div>
            {{#if ab.description}}<p>{{ab.description}}</p>{{/if}}
        </div>
        {{else}}
        <p class="gb-empty gb-empty--sm">Esta classe não tem habilidades.</p>
        {{/each}}
        {{else}}
        <p class="gb-empty">Escolha a classe na placa do nome, ao lado da arte, ou arraste uma do compêndio <em>Granblue — Classes</em>.</p>
        {{/if}}
    </article>

    <article class="gb-codex-card gb-codex-card--heritage gb-frame">
        <header class="gb-codex-head">
            <span class="gb-codex-emblem"><i class="fa-solid fa-dna"></i></span>
            <div class="gb-codex-titles">
                <span class="gb-kicker">Herança</span>
                <h2>{{#if heritageItem}}{{heritageItem.name}}{{else}}Sem herança{{/if}}</h2>
            </div>
            {{#if heritageItem}}
            <div class="gb-tools">
                <a class="gb-icon-btn" data-action="openEmbedded" data-item-id="{{heritageItem.id}}" data-tooltip="Abrir a herança"><i class="fa-solid fa-up-right-from-square"></i></a>
                <a class="gb-icon-btn gb-icon-btn--danger" data-action="removeEmbedded" data-item-id="{{heritageItem.id}}" data-tooltip="Remover a herança"><i class="fa-solid fa-trash"></i></a>
            </div>
            {{/if}}
        </header>
        {{#if heritageItem}}
        {{#if heritageBonuses.length}}
        <div class="gb-codex-bonuses">
            {{#each heritageBonuses as |b|}}<span class="gb-chip gb-chip--gold"><b>{{granblueSigned b.value}}</b> {{b.label}}</span>{{/each}}
        </div>
        {{/if}}
        {{#if heritageItem.system.sharedTrait}}
        <div class="gb-feature">
            <div class="gb-feature-head">
                <strong>Traço Compartilhado</strong>
                <a class="gb-icon-btn" data-action="postFeature" data-feature="trait" data-tooltip="Mostrar no chat o que este traço faz"><i class="fa-solid fa-comment"></i></a>
            </div>
            <div class="gb-feature-html">{{{heritageItem.system.sharedTrait}}}</div>
        </div>
        {{/if}}
        {{#if heritageItem.system.weakness}}
        <div class="gb-feature gb-feature--weak">
            <div class="gb-feature-head">
                <strong>Debilidade</strong>
                <a class="gb-icon-btn" data-action="postFeature" data-feature="weakness" data-tooltip="Mostrar no chat o que esta debilidade faz"><i class="fa-solid fa-comment"></i></a>
            </div>
            <div class="gb-feature-html">{{{heritageItem.system.weakness}}}</div>
        </div>
        {{/if}}
        {{#if heritageProgress.length}}<h4 class="gb-codex-sub">Progressos</h4>{{/if}}
        {{#each heritageProgress as |p idx|}}
        <div class="gb-feature">
            <div class="gb-feature-head">
                <strong>{{p.name}}</strong>
                {{#if p.requirement}}<span class="gb-tag">{{p.requirement}}</span>{{/if}}
                <a class="gb-icon-btn" data-action="postFeature" data-feature="progress" data-index="{{idx}}" data-tooltip="Mostrar no chat o que este progresso faz"><i class="fa-solid fa-comment"></i></a>
            </div>
            {{#if p.description}}<p>{{p.description}}</p>{{/if}}
        </div>
        {{/each}}
        {{else}}
        <p class="gb-empty">Escolha a herança na placa do nome, ao lado da arte, ou arraste uma do compêndio <em>Granblue — Heranças</em>.</p>
        {{/if}}
    </article>
</div>
