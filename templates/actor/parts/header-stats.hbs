{{!--
    Números do cabeçalho (personagem e adversário), em chips compactos que
    quebram linha quando a ficha estreita. Só a Visão é editável aqui: o
    deslocamento base e o bônus ficam no bloco Deslocamento das abas.
--}}
<div class="gb-hd-stats">
    <span class="gb-stat gb-stat--ca" title="Classe de Armadura: 10 + Reação + bônus">
        <span class="gb-stat-label">CA</span><span class="gb-stat-value">{{ca}}</span>
    </span>
    <span class="gb-stat gb-stat--rd" title="RD física (fixa + bônus + temporária): abatida do dano físico aplicado pelo chat">
        <span class="gb-stat-label">RD F</span><span class="gb-stat-value">{{rd.physical.total}}</span>
    </span>
    <span class="gb-stat gb-stat--rdm" title="RD mágica (fixa + bônus + temporária): abatida do dano mágico aplicado pelo chat">
        <span class="gb-stat-label">RD M</span><span class="gb-stat-value">{{rd.magical.total}}</span>
    </span>
    <span class="gb-stat gb-stat--move" title="Deslocamento (base + bônus) — edite no bloco Deslocamento">
        <span class="gb-stat-label">Mov</span><span class="gb-stat-value">{{movementLabel}}</span>
    </span>
    <label class="gb-stat gb-stat--input" title="Visão">
        <span class="gb-stat-label">Visão</span>
        <input type="text" name="system.vision" value="{{system.vision}}" placeholder="—">
    </label>
</div>
