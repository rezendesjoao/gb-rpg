{{!-- Ficha de Adversário / NPC --}}
<div class="gb-root">
<div class="gb-top">
    <figure class="gb-portrait-panel">
        <img class="gb-portrait" src="{{actor.img}}" data-action="editImage" data-edit="img" alt="{{actor.name}}" title="Clique para trocar a imagem">
        <a class="gb-portrait-zoom" data-action="showArtwork" title="Ver a arte em tamanho real"><i class="fa-solid fa-expand"></i></a>
    </figure>
    <div class="gb-top-main">
        <header class="gb-header gb-header--adv">
            <div class="gb-identity">
                <input class="gb-name" type="text" name="name" value="{{actor.name}}" placeholder="Nome do adversário">
                <div class="gb-identity-grid">
                    <label class="gb-field">
                        <span>Dificuldade</span>
                        <select name="system.difficulty">
                            {{#each difficultyOptions as |o|}}<option value="{{o.value}}" {{#if o.selected}}selected{{/if}}>{{o.label}}</option>{{/each}}
                        </select>
                    </label>
                    <label class="gb-field">
                        <span>Tipagem</span>
                        <select name="system.creatureType">
                            {{#each typeOptions as |o|}}<option value="{{o.value}}" {{#if o.selected}}selected{{/if}}>{{o.label}}</option>{{/each}}
                        </select>
                    </label>
                    <label class="gb-field gb-field--sm"><span>Rank</span><input type="text" name="system.rank" value="{{system.rank}}"></label>
                    <label class="gb-field gb-field--sm"><span>Nível</span><input type="number" name="system.level" value="{{system.level}}" min="0"></label>
                </div>
            </div>
            <div class="gb-header-stats">
                <div class="gb-badge gb-badge--ca" title="10 + Reação + bônus"><span class="gb-badge-label">CA</span><span class="gb-badge-value">{{ca}}</span></div>
                <label class="gb-badge gb-badge--rd" title="Redução de Dano: abatida do dano aplicado pelo chat (Shift+clique no botão de dano = dano verdadeiro){{#if (ne rd rdSource)}} · com efeitos: {{rd}}{{/if}}">
                    <span class="gb-badge-label">RD</span>
                    <input class="gb-badge-input" type="number" name="system.defenses.rd" value="{{rdSource}}" min="0">
                </label>
                <label class="gb-field gb-field--sm"><span>Mov</span><input type="text" name="system.movement" value="{{system.movement}}"></label>
                <label class="gb-field gb-field--sm"><span>Visão</span><input type="text" name="system.vision" value="{{system.vision}}"></label>
            </div>
        </header>

        {{!-- Barra de vitais sempre visível --}}
        <div class="gb-vitals">
            <div class="gb-vital gb-vital--hp">
                <div class="gb-vital-fill" style="width:{{hpPct}}%"></div>
                <div class="gb-vital-content">
                    <span class="gb-vital-name"><i class="fa-solid fa-heart"></i> Energia Vital</span>
                    <span class="gb-vital-nums">
                        <input type="number" name="system.resources.hitPoints.value" value="{{hp.value}}" title="Vida atual">
                        <span class="gb-vital-sep">/</span>
                        <input type="number" name="system.resources.hitPoints.max" value="{{hp.max}}" title="Vida máxima">
                    </span>
                </div>
            </div>
            <div class="gb-vital gb-vital--mana">
                <div class="gb-vital-fill" style="width:{{manaPct}}%"></div>
                <div class="gb-vital-content">
                    <span class="gb-vital-name"><i class="fa-solid fa-droplet"></i> Mana</span>
                    <span class="gb-vital-nums">
                        <input type="number" name="system.resources.mana.value" value="{{mana.value}}" title="Mana atual">
                        <span class="gb-vital-sep">/</span>
                        <input type="number" name="system.resources.mana.max" value="{{mana.max}}" title="Mana máxima">
                    </span>
                </div>
            </div>
        </div>
    </div>
</div>

<nav class="gb-tabs">
    <a data-tab-nav="principal"><i class="fa-solid fa-dragon"></i> Estatísticas</a>
    <a data-tab-nav="acoes"><i class="fa-solid fa-khanda"></i> Ataques</a>
    <a data-tab-nav="loot"><i class="fa-solid fa-sack-dollar"></i> Loot</a>
    <a data-tab-nav="bio"><i class="fa-solid fa-book"></i> Biografia</a>
</nav>

{{!-- ===================== ESTATÍSTICAS ===================== --}}
<section class="gb-tab" data-tab-content="principal">
    <div class="gb-res-details">
        <div class="gb-res-block gb-res-block--hp">
            <h4><i class="fa-solid fa-heart"></i> Energia Vital</h4>
            <div class="gb-res-grid">
                <label><span>Base</span><input type="number" name="system.resources.hitPoints.base" value="{{hp.base}}"></label>
                <label><span>Dado</span><input type="number" name="system.resources.hitPoints.die" value="{{hp.die}}"></label>
                <label><span>Res×3</span><span class="gb-derived">{{hp.mod}}</span></label>
                <label><span>Temp</span><input type="number" name="system.resources.hitPoints.temp" value="{{hp.temp}}"></label>
            </div>
            <a class="gb-recalc" data-action="recalcMax" title="base + Res×3 + dado + temp"><i class="fa-solid fa-arrows-rotate"></i> Recalcular máx ({{hp.maxFormula}})</a>
        </div>
        <div class="gb-res-block gb-res-block--ca">
            <h4><i class="fa-solid fa-shield-halved"></i> CA</h4>
            <div class="gb-res-ca">{{ca}}</div>
            <label class="gb-cabonus"><span>Bônus</span><input type="number" name="system.defenses.caBonus" value="{{caBonus}}"></label>
        </div>
        <div class="gb-res-block gb-res-block--mana">
            <h4><i class="fa-solid fa-droplet"></i> Mana</h4>
            <div class="gb-hint">Máx sugerido: <strong>{{mana.maxFormula}}</strong> (Sab×2)</div>
        </div>
    </div>

    <h3 class="gb-section-title"><i class="fa-solid fa-scale-unbalanced"></i> Vantagens &amp; Desvantagens</h3>
    <div class="gb-adv-grid">
        <label class="gb-adv gb-adv--pro">
            <span><i class="fa-solid fa-circle-plus"></i> Vantagem</span>
            <textarea name="system.advantage" placeholder="O que favorece esta criatura: resistências, imunidades, terreno…">{{system.advantage}}</textarea>
        </label>
        <label class="gb-adv gb-adv--con">
            <span><i class="fa-solid fa-circle-minus"></i> Desvantagem</span>
            <textarea name="system.disadvantage" placeholder="A fraqueza revelada ao analisar o poder de combate…">{{system.disadvantage}}</textarea>
        </label>
    </div>

    <h3 class="gb-section-title">Atributos <span class="gb-hint">clique para testar (3d6 + atributo)</span></h3>
    <div class="gb-attributes">
        {{#each attributes as |attr|}}
        <div class="gb-attribute">
            <a class="gb-attr-roll" data-action="rollAttribute" data-attribute="{{attr.key}}" title="{{attr.func}}">
                <span class="gb-attr-name">{{attr.label}}</span>
                <span class="gb-attr-total">{{attr.total}}</span>
                <span class="gb-attr-dice">3d6</span>
            </a>
            <div class="gb-attr-inputs">
                <label><span>Valor</span><input type="number" name="system.attributes.{{attr.key}}.value" value="{{attr.value}}"></label>
                <label><span>Bônus</span><input type="number" name="system.attributes.{{attr.key}}.bonus" value="{{attr.bonus}}"></label>
            </div>
        </div>
        {{/each}}
    </div>
</section>

{{!-- ===================== ATAQUES ===================== --}}
<section class="gb-tab" data-tab-content="acoes">
    <div class="gb-actions-toolbar">
        <button type="button" data-action="addAction"><i class="fa-solid fa-plus"></i> Adicionar ataque</button>
        <button type="button" data-action="addAction" data-passive="true"><i class="fa-solid fa-feather"></i> Adicionar passiva</button>
    </div>
    {{#each actions as |action idx|}}
    {{> "systems/granblue/templates/actor/parts/action-row.hbs" row=action index=idx list="actions"}}
    {{else}}
    <p class="gb-empty">Nenhum ataque cadastrado.</p>
    {{/each}}
</section>

{{!-- ===================== LOOT ===================== --}}
<section class="gb-tab" data-tab-content="loot">
    <div class="gb-actions-toolbar">
        <button type="button" data-action="addLoot"><i class="fa-solid fa-plus"></i> Adicionar espólio</button>
        {{#if isGM}}
        <button type="button" class="gb-loot-send-btn" data-action="sendLoot" title="Abre para os jogadores um pop-up com a chance de cada espólio (sem o nome) e o d100 de cada um">
            <i class="fa-solid fa-paper-plane"></i> Enviar rolagem de loot aos jogadores
        </button>
        {{/if}}
    </div>
    <p class="gb-hint">
        <strong>Chance</strong>: tirar no d100 igual ou menos consegue o item{{#if dropBonus}} — a dificuldade {{difficultyLabel}} soma <strong>+{{dropBonus}}%</strong> no envio{{/if}}.
        <strong>Quantidade</strong>: número ou fórmula (<code>1d3</code>, <code>2</code>).
        <strong>Qualidades</strong>: até onde o item pode chegar — o d100 de qualidade dá Boa ≤50, Rara ≤25, Primorosa ≤12, Matéria-prima ≤5.
    </p>
    <div class="gb-loot">
        {{#each loot as |l idx|}}
        <div class="gb-loot-row{{#if l.invalid}} gb-loot-row--invalid{{/if}}">
            <label class="gb-loot-chance"><span>Chance</span><input type="text" name="system.loot.{{idx}}.chance" value="{{l.chance}}" placeholder="35%"{{#if l.invalid}} title="Chance sem número: este espólio não vai para a rolagem"{{/if}}></label>
            <label class="gb-loot-item"><span>Item</span><input type="text" name="system.loot.{{idx}}.item" value="{{l.item}}" placeholder="Couro de Lobo"></label>
            <label class="gb-loot-qty"><span>Quantidade</span><input type="text" name="system.loot.{{idx}}.quantity" value="{{l.quantity}}" placeholder="1d3"></label>
            <label class="gb-loot-quality"><span>Qualidades</span>
                <select name="system.loot.{{idx}}.quality">
                    {{#each @root.lootQualityOptions as |o|}}
                    <option value="{{o.value}}" {{#if (eqStr o.value l.quality)}}selected{{/if}}>{{o.label}}</option>
                    {{/each}}
                </select>
            </label>
            <a class="gb-btn gb-btn--del" data-action="deleteLoot" data-index="{{idx}}" title="Remover"><i class="fa-solid fa-trash"></i></a>
        </div>
        {{else}}
        <p class="gb-empty">Nenhum espólio cadastrado.</p>
        {{/each}}
    </div>
</section>

{{!-- ===================== BIOGRAFIA ===================== --}}
<section class="gb-tab" data-tab-content="bio">
    <label class="gb-bio"><span>Atribuições Aparentes</span><textarea name="system.biography.appearance">{{biography.appearance}}</textarea></label>
    <label class="gb-bio"><span>"Inner Demons" e Conflitos</span><textarea name="system.biography.demons">{{biography.demons}}</textarea></label>
    <label class="gb-bio"><span>Metas e Motivações</span><textarea name="system.biography.motivations">{{biography.motivations}}</textarea></label>
    <label class="gb-bio"><span>Worldview</span><textarea name="system.biography.worldview">{{biography.worldview}}</textarea></label>
    <label class="gb-bio"><span>Backstory</span><textarea name="system.biography.backstory">{{biography.backstory}}</textarea></label>
    <label class="gb-bio"><span>Descrição</span><textarea name="system.description">{{description}}</textarea></label>
    <label class="gb-bio"><span>Notas</span><textarea name="system.notes">{{notes}}</textarea></label>
</section>
</div>
