{{!-- Ficha de Personagem (Guerreiro Mágico) --}}
<div class="gb-root">
<div class="gb-top">
    <figure class="gb-portrait-panel">
        <img class="gb-portrait" src="{{actor.img}}" data-action="editImage" data-edit="img" alt="{{actor.name}}" title="Clique para trocar a imagem">
        <a class="gb-portrait-zoom" data-action="showArtwork" title="Ver a arte em tamanho real"><i class="fa-solid fa-expand"></i></a>
    </figure>
    <div class="gb-top-main">
        <header class="gb-header">
            <div class="gb-identity">
                <input class="gb-name" type="text" name="name" value="{{actor.name}}" placeholder="Nome do personagem">
                <div class="gb-identity-grid">
                    <label class="gb-field">
                        <span>Classe</span>
                        <select data-gb-chooser="class">
                            <option value="" {{#if classBlankSelected}}selected{{/if}}>—</option>
                            {{#each classGroups as |grp|}}
                            <optgroup label="{{grp.label}}">
                                {{#each grp.options as |o|}}
                                <option value="{{o.value}}" {{#if o.selected}}selected{{/if}}>{{o.label}}</option>
                                {{/each}}
                            </optgroup>
                            {{/each}}
                        </select>
                    </label>
                    <label class="gb-field">
                        <span>Herança</span>
                        <select data-gb-chooser="heritage">
                            <option value="" {{#if heritageBlankSelected}}selected{{/if}}>—</option>
                            {{#each heritageOptions as |o|}}
                            <option value="{{o.value}}" {{#if o.selected}}selected{{/if}}>{{o.label}}</option>
                            {{/each}}
                        </select>
                    </label>
                    <label class="gb-field gb-field--sm">
                        <span>Rank</span>
                        <select name="system.rank">
                            {{#each rankOptions as |o|}}
                            <option value="{{o.value}}" {{#if o.selected}}selected{{/if}}>{{o.label}}</option>
                            {{/each}}
                        </select>
                    </label>
                    <label class="gb-field gb-field--sm">
                        <span>Nível</span>
                        <input type="number" name="system.level" value="{{system.level}}" min="0">
                    </label>
                </div>
            </div>
            <div class="gb-header-stats">
                <div class="gb-badge gb-badge--ca" title="10 + Reação + bônus">
                    <span class="gb-badge-label">CA</span>
                    <span class="gb-badge-value">{{ca}}</span>
                </div>
                <label class="gb-field gb-field--sm"><span>Mov</span><input type="text" name="system.movement" value="{{system.movement}}"></label>
                <label class="gb-field gb-field--sm"><span>Visão</span><input type="text" name="system.vision" value="{{system.vision}}"></label>
            </div>
        </header>

        {{!-- Barra de vitais sempre visível --}}
        <div class="gb-vitals">
            <div class="gb-vital gb-vital--hp">
                <div class="gb-vital-fill" style="width:{{hpPct}}%"></div>
                <div class="gb-vital-content">
                    <span class="gb-vital-name"><i class="fa-solid fa-heart"></i> Energia Vital</span>
                    <span class="gb-vital-nums">
                        <input type="number" name="system.resources.hitPoints.value" value="{{hp.value}}" title="Vida atual">
                        <span class="gb-vital-sep">/</span>
                        <input type="number" name="system.resources.hitPoints.max" value="{{hp.max}}" title="Vida máxima">
                    </span>
                </div>
            </div>
            <div class="gb-vital gb-vital--mana">
                <div class="gb-vital-fill" style="width:{{manaPct}}%"></div>
                <div class="gb-vital-content">
                    <span class="gb-vital-name"><i class="fa-solid fa-droplet"></i> Mana</span>
                    <span class="gb-vital-nums">
                        <input type="number" name="system.resources.mana.value" value="{{mana.value}}" title="Mana atual">
                        <span class="gb-vital-sep">/</span>
                        <input type="number" name="system.resources.mana.max" value="{{mana.max}}" title="Mana máxima">
                    </span>
                </div>
            </div>
        </div>
    </div>
</div>

<nav class="gb-tabs">
    <a data-tab-nav="atributos"><i class="fa-solid fa-hand-fist"></i> Atributos</a>
    <a data-tab-nav="acoes"><i class="fa-solid fa-khanda"></i> Ações</a>
    <a data-tab-nav="magia"><i class="fa-solid fa-wand-sparkles"></i> Magia</a>
    <a data-tab-nav="inventario"><i class="fa-solid fa-bag-shopping"></i> Inventário</a>
    <a data-tab-nav="identidade"><i class="fa-solid fa-id-badge"></i> Classe & Herança</a>
    <a data-tab-nav="bio"><i class="fa-solid fa-book"></i> Biografia</a>
</nav>

{{!-- ===================== ATRIBUTOS ===================== --}}
<section class="gb-tab" data-tab-content="atributos">
    <div class="gb-attributes">
        {{#each attributes as |attr|}}
        <div class="gb-attribute">
            <a class="gb-attr-roll" data-action="rollAttribute" data-attribute="{{attr.key}}" title="{{attr.func}} — clique para testar">
                <span class="gb-attr-name">{{attr.label}}</span>
                <span class="gb-attr-total">{{attr.total}}</span>
                <span class="gb-attr-dice"><i class="fa-solid fa-dice-d6"></i> 3d6{{#if attr.effect}} <span class="gb-attr-effect" title="Bônus de herança/efeitos">({{granblueSigned attr.effect}})</span>{{/if}}</span>
            </a>
            <div class="gb-attr-inputs">
                <label><span>Valor</span><input type="number" name="system.attributes.{{attr.key}}.value" value="{{attr.value}}"></label>
                <label><span>Bônus</span><input type="number" name="system.attributes.{{attr.key}}.bonus" value="{{attr.bonus}}"></label>
            </div>
        </div>
        {{/each}}
    </div>
    <div class="gb-pointbuy">
        Pontos de atributo: <strong>{{pointBuy.spent}}</strong> / {{pointBuy.total}}
        <span class="{{#if pointBuy.remaining}}gb-remaining{{/if}}">(restam {{pointBuy.remaining}})</span>
    </div>

    <h3 class="gb-section-title">Detalhes de Recursos</h3>
    <div class="gb-res-details">
        <div class="gb-res-block gb-res-block--hp">
            <h4><i class="fa-solid fa-heart"></i> Energia Vital</h4>
            <div class="gb-res-grid">
                {{#if hasClass}}
                <label><span>Base</span><span class="gb-derived" title="Classe: {{classItem.name}}">{{hp.base}}</span></label>
                {{else}}
                <label><span>Base</span><input type="number" name="system.resources.hitPoints.base" value="{{hpSource.base}}"></label>
                {{/if}}
                <label class="gb-die"><span>Dado</span><input type="number" name="system.resources.hitPoints.die" value="{{hp.die}}"><a data-action="rollHitDie" title="Rolar dado de vida"><i class="fa-solid fa-dice-d6"></i></a></label>
                <label><span>Res×3</span><span class="gb-derived">{{hp.mod}}</span></label>
                <label><span>Temp</span><input type="number" name="system.resources.hitPoints.temp" value="{{hp.temp}}"></label>
            </div>
            <a class="gb-recalc" data-action="recalcMax" title="base + Res×3 + dado + temp"><i class="fa-solid fa-arrows-rotate"></i> Recalcular máx ({{hp.maxFormula}})</a>
        </div>
        <div class="gb-res-block gb-res-block--ca">
            <h4><i class="fa-solid fa-shield-halved"></i> Classe de Armadura</h4>
            <div class="gb-res-ca">{{ca}}</div>
            <label class="gb-cabonus"><span>Bônus</span><input type="number" name="system.defenses.caBonus" value="{{caBonus}}"></label>
            <div class="gb-hint">10 + Reação + bônus</div>
        </div>
        <div class="gb-res-block gb-res-block--mana">
            <h4><i class="fa-solid fa-droplet"></i> Mana</h4>
            <div class="gb-hint">Máx sugerido: <strong>{{mana.maxFormula}}</strong> (Sab×2)</div>
            <a class="gb-recalc" data-action="recalcMax" title="Sabedoria × 2"><i class="fa-solid fa-arrows-rotate"></i> Recalcular</a>
        </div>
    </div>
</section>

{{!-- ===================== AÇÕES ===================== --}}
<section class="gb-tab" data-tab-content="acoes">
    <div class="gb-actions-toolbar">
        <button type="button" data-action="addAction"><i class="fa-solid fa-plus"></i> Adicionar ação</button>
    </div>
    <p class="gb-hint">Ataques e manobras não-mágicas. Magias ficam na aba <strong>Magia</strong>, dentro da esfera delas.
        Atalhos nas fórmulas: <code>@forca @precisao @reacao @resiliencia @percepcao @carisma @sabedoria @potencia @disciplina @nivel @ca</code>.
        Ao clicar para rolar, abre a janela de bônus situacional.</p>

    {{#each actions as |action idx|}}
    <div class="gb-action gb-action--collapsed" data-list="actions" data-action-index="{{idx}}">
        <div class="gb-action-head">
            <a class="gb-collapse-toggle" data-action="toggleAction" data-index="{{idx}}" title="Expandir / recolher"><i class="fa-solid fa-chevron-right"></i></a>
            <input type="text" class="gb-action-name" name="system.actions.{{idx}}.name" value="{{action.name}}">
            <span class="gb-action-btns">
                <a class="gb-icn" data-action="moveAction" data-index="{{idx}}" data-dir="up" title="Mover para cima"><i class="fa-solid fa-chevron-up"></i></a>
                <a class="gb-icn" data-action="moveAction" data-index="{{idx}}" data-dir="down" title="Mover para baixo"><i class="fa-solid fa-chevron-down"></i></a>
                <a class="gb-btn gb-btn--roll" data-action="rollActionFull" data-index="{{idx}}" data-drag-action="{{idx}}" draggable="true" title="Rolar ação (clique) · arraste para a barra de macros"><i class="fa-solid fa-dice-d20"></i></a>
                <a class="gb-btn gb-btn--hit gb-only-expanded" data-action="rollAction" data-index="{{idx}}" data-part="hit" title="Rolar acerto"><i class="fa-solid fa-crosshairs"></i></a>
                <a class="gb-btn gb-btn--dmg gb-only-expanded" data-action="rollAction" data-index="{{idx}}" data-part="damage" title="Rolar dano"><i class="fa-solid fa-burst"></i></a>
                <a class="gb-btn gb-btn--del" data-action="deleteAction" data-index="{{idx}}" title="Remover"><i class="fa-solid fa-trash"></i></a>
            </span>
        </div>
        <div class="gb-action-details">
            <div class="gb-action-formulas">
                <label><span>Acerto</span><input type="text" name="system.actions.{{idx}}.hit" value="{{action.hit}}" placeholder="3d6 + @precisao"></label>
                <label><span>Dano</span><input type="text" name="system.actions.{{idx}}.damage" value="{{action.damage}}" placeholder="2d8 + @forca"></label>
            </div>
            <div class="gb-action-meta">
                <label><span>Custo</span><input type="text" name="system.actions.{{idx}}.cost" value="{{action.cost}}"></label>
                <label><span>Alcance</span><input type="text" name="system.actions.{{idx}}.range" value="{{action.range}}"></label>
                <label><span>Conjuração</span><input type="text" name="system.actions.{{idx}}.casting" value="{{action.casting}}"></label>
                <label><span>Dificuldade</span><input type="text" name="system.actions.{{idx}}.difficulty" value="{{action.difficulty}}"></label>
            </div>
            <label class="gb-action-effect"><span>Efeito</span><input type="text" name="system.actions.{{idx}}.effect" value="{{action.effect}}"></label>
            <label class="gb-action-desc"><span>Descrição</span><input type="text" name="system.actions.{{idx}}.description" value="{{action.description}}"></label>
        </div>
    </div>
    {{else}}
    <p class="gb-empty">Nenhuma ação. Clique em "Adicionar ação".</p>
    {{/each}}
</section>

{{!-- ===================== MAGIA ===================== --}}
<section class="gb-tab" data-tab-content="magia">
    <h3 class="gb-section-title">Esferas de Magia</h3>
    <p class="gb-hint">Pontos de esfera: <strong>{{spherePoints.spent}}</strong> / {{spherePoints.total}} (restam {{spherePoints.remaining}}).
        Custo de desbloqueio entre parênteses. Crie a magia dentro da esfera dela — a rolagem fica aqui mesmo.</p>

    {{#each spheres as |s|}}
    <section class="gb-sphere-group{{#unless s.unlocked}} gb-sphere-group--locked{{/unless}}" data-sphere="{{s.key}}">
        <header class="gb-sphere-head">
            <h4 class="gb-sphere-title">{{s.label}} <em>({{s.custo}})</em></h4>
            <label class="gb-sphere-pts" title="Pontos investidos nesta esfera">
                <span>Pontos</span>
                <input type="number" name="system.spheres.{{s.key}}" value="{{s.value}}" min="0">
            </label>
            <button type="button" class="gb-sphere-add" data-action="addSpell" data-sphere="{{s.key}}" title="Criar uma magia nesta esfera">
                <i class="fa-solid fa-plus"></i> Nova magia
            </button>
        </header>

        {{#each s.spells as |sp|}}
        <div class="gb-action gb-action--spell gb-action--collapsed" data-list="spells" data-action-index="{{sp.index}}">
            <div class="gb-action-head">
                <a class="gb-collapse-toggle" data-action="toggleAction" data-list="spells" data-index="{{sp.index}}" title="Expandir / recolher"><i class="fa-solid fa-chevron-right"></i></a>
                <input type="text" class="gb-action-name" name="system.spells.{{sp.index}}.name" value="{{sp.name}}">
                {{#if sp.arcano}}<span class="gb-chip gb-chip--arcano" title="Arcano">{{sp.arcano}}</span>{{/if}}
                <span class="gb-action-btns">
                    <a class="gb-icn" data-action="moveAction" data-list="spells" data-index="{{sp.index}}" data-dir="up" title="Mover para cima"><i class="fa-solid fa-chevron-up"></i></a>
                    <a class="gb-icn" data-action="moveAction" data-list="spells" data-index="{{sp.index}}" data-dir="down" title="Mover para baixo"><i class="fa-solid fa-chevron-down"></i></a>
                    <a class="gb-btn gb-btn--roll" data-action="rollActionFull" data-list="spells" data-index="{{sp.index}}" data-drag-action="{{sp.index}}" draggable="true" title="Conjurar (clique) · arraste para a barra de macros"><i class="fa-solid fa-dice-d20"></i></a>
                    <a class="gb-btn gb-btn--hit gb-only-expanded" data-action="rollAction" data-list="spells" data-index="{{sp.index}}" data-part="hit" title="Rolar acerto"><i class="fa-solid fa-crosshairs"></i></a>
                    <a class="gb-btn gb-btn--dmg gb-only-expanded" data-action="rollAction" data-list="spells" data-index="{{sp.index}}" data-part="damage" title="Rolar dano / cura"><i class="fa-solid fa-burst"></i></a>
                    <a class="gb-btn gb-btn--del" data-action="deleteAction" data-list="spells" data-index="{{sp.index}}" title="Remover"><i class="fa-solid fa-trash"></i></a>
                </span>
            </div>
            <div class="gb-action-details">
                <div class="gb-spell-meta">
                    <label><span>Esfera</span>
                        <select name="system.spells.{{sp.index}}.sphere" title="Mover a magia para outra esfera">
                            {{#each @root.sphereOptions as |o|}}
                            <option value="{{o.value}}" {{#if (eqStr o.value sp.sphereKey)}}selected{{/if}}>{{o.label}}</option>
                            {{/each}}
                        </select>
                    </label>
                    <label><span>Arcano</span><input type="text" name="system.spells.{{sp.index}}.arcano" value="{{sp.arcano}}" placeholder="Cura, Espírito…"></label>
                    <label><span>Nível</span><input type="number" name="system.spells.{{sp.index}}.level" value="{{sp.level}}" min="1" max="9"></label>
                </div>
                <div class="gb-action-formulas">
                    <label><span>Acerto</span><input type="text" name="system.spells.{{sp.index}}.hit" value="{{sp.hit}}" placeholder="3d6 + @disciplina"></label>
                    <label><span>Dano / Cura</span><input type="text" name="system.spells.{{sp.index}}.damage" value="{{sp.damage}}" placeholder="2d8 + @potencia"></label>
                </div>
                <div class="gb-action-meta">
                    <label><span>Custo</span><input type="text" name="system.spells.{{sp.index}}.cost" value="{{sp.cost}}" placeholder="mana"></label>
                    <label><span>Alcance</span><input type="text" name="system.spells.{{sp.index}}.range" value="{{sp.range}}"></label>
                    <label><span>Conjuração</span><input type="text" name="system.spells.{{sp.index}}.casting" value="{{sp.casting}}"></label>
                    <label><span>Dificuldade</span><input type="text" name="system.spells.{{sp.index}}.difficulty" value="{{sp.difficulty}}"></label>
                </div>
                <label class="gb-action-effect"><span>Efeito</span><input type="text" name="system.spells.{{sp.index}}.effect" value="{{sp.effect}}"></label>
                <label class="gb-action-desc"><span>Descrição</span><input type="text" name="system.spells.{{sp.index}}.description" value="{{sp.description}}"></label>
            </div>
        </div>
        {{else}}
        <p class="gb-empty gb-empty--sm">Nenhuma magia nesta esfera.</p>
        {{/each}}
    </section>
    {{/each}}

    {{#if orphanSpells}}
    <section class="gb-sphere-group gb-sphere-group--orphan">
        <header class="gb-sphere-head">
            <h4 class="gb-sphere-title">Sem esfera definida</h4>
            <span class="gb-hint">Escolha a esfera de cada magia para movê-la para o grupo certo.</span>
        </header>
        {{#each orphanSpells as |sp|}}
        <div class="gb-action gb-action--spell gb-action--orphan" data-list="spells" data-action-index="{{sp.index}}">
            <div class="gb-action-head">
                <span class="gb-orphan-warn" title="Esfera não reconhecida"><i class="fa-solid fa-triangle-exclamation"></i></span>
                <input type="text" class="gb-action-name" name="system.spells.{{sp.index}}.name" value="{{sp.name}}">
                <select class="gb-orphan-sphere" name="system.spells.{{sp.index}}.sphere">
                    <option value="" selected>— esfera —</option>
                    {{#each @root.sphereOptions as |o|}}
                    <option value="{{o.value}}">{{o.label}}</option>
                    {{/each}}
                </select>
                <span class="gb-action-btns">
                    <a class="gb-btn gb-btn--roll" data-action="rollActionFull" data-list="spells" data-index="{{sp.index}}" title="Conjurar"><i class="fa-solid fa-dice-d20"></i></a>
                    <a class="gb-btn gb-btn--del" data-action="deleteAction" data-list="spells" data-index="{{sp.index}}" title="Remover"><i class="fa-solid fa-trash"></i></a>
                </span>
            </div>
        </div>
        {{/each}}
    </section>
    {{/if}}

    <h3 class="gb-section-title">Progressos de Rank</h3>
    <div class="gb-progress">
        <label><span>Atual</span><input type="number" name="system.progress.current" value="{{progress.current}}"></label>
        <span class="gb-sep">/</span>
        <label><span>Necessário</span><input type="number" name="system.progress.final" value="{{progress.final}}"></label>
    </div>
</section>

{{!-- ===================== INVENTÁRIO ===================== --}}
<section class="gb-tab" data-tab-content="inventario">
    <div class="gb-inv-summary">
        <label class="gb-field gb-field--sm gb-inv-currency">
            <span><i class="fa-solid fa-coins"></i> Moedas</span>
            <input type="number" name="system.currency" value="{{currency}}" min="0">
        </label>
        <span class="gb-hint">
            {{inventoryCount}} item(ns){{#if inventoryWeight}} · peso total <strong>{{inventoryWeight}}</strong>{{/if}}
        </span>
    </div>

    {{#each inventoryGroups as |grp|}}
    <section class="gb-inv-group" data-category="{{grp.key}}">
        <header class="gb-sphere-head">
            <h4 class="gb-sphere-title">{{grp.label}}</h4>
            <button type="button" class="gb-sphere-add" data-action="addInventory" data-category="{{grp.key}}" title="Adicionar item nesta categoria">
                <i class="fa-solid fa-plus"></i> Adicionar item
            </button>
        </header>

        {{#each grp.items as |it|}}
        <div class="gb-action gb-action--inv gb-action--collapsed{{#if it.equipped}} gb-action--equipped{{/if}}" data-list="inventory" data-action-index="{{it.index}}">
            <div class="gb-action-head">
                <a class="gb-collapse-toggle" data-action="toggleInventory" data-index="{{it.index}}" title="Expandir / recolher"><i class="fa-solid fa-chevron-right"></i></a>
                <label class="gb-inv-eq" title="Equipado / em uso">
                    <input type="checkbox" name="system.inventory.{{it.index}}.equipped" {{#if it.equipped}}checked{{/if}}>
                </label>
                <input type="text" class="gb-action-name" name="system.inventory.{{it.index}}.name" value="{{it.name}}">
                <label class="gb-inv-qty" title="Quantidade">
                    <span>×</span><input type="number" name="system.inventory.{{it.index}}.quantity" value="{{it.quantity}}" min="0">
                </label>
                <span class="gb-action-btns">
                    <a class="gb-icn" data-action="moveInventory" data-index="{{it.index}}" data-dir="up" title="Mover para cima"><i class="fa-solid fa-chevron-up"></i></a>
                    <a class="gb-icn" data-action="moveInventory" data-index="{{it.index}}" data-dir="down" title="Mover para baixo"><i class="fa-solid fa-chevron-down"></i></a>
                    <a class="gb-btn gb-btn--del" data-action="deleteInventory" data-index="{{it.index}}" title="Remover"><i class="fa-solid fa-trash"></i></a>
                </span>
            </div>
            <div class="gb-action-details">
                <div class="gb-inv-meta">
                    <label><span>Categoria</span>
                        <select name="system.inventory.{{it.index}}.category">
                            {{#each @root.categoryOptions as |o|}}
                            <option value="{{o.value}}" {{#if (eqStr o.value it.categoryKey)}}selected{{/if}}>{{o.label}}</option>
                            {{/each}}
                        </select>
                    </label>
                    <label><span>Tier</span>
                        <select name="system.inventory.{{it.index}}.tier">
                            <option value="" {{#unless it.tier}}selected{{/unless}}>—</option>
                            {{#each @root.tierOptions as |o|}}
                            <option value="{{o.value}}" {{#if (eqStr o.value it.tier)}}selected{{/if}}>{{o.label}}</option>
                            {{/each}}
                        </select>
                    </label>
                    <label><span>Qualidade</span>
                        <select name="system.inventory.{{it.index}}.quality">
                            <option value="" {{#unless it.quality}}selected{{/unless}}>—</option>
                            {{#each @root.qualityOptions as |o|}}
                            <option value="{{o.value}}" {{#if (eqStr o.value it.quality)}}selected{{/if}}>{{o.label}}</option>
                            {{/each}}
                        </select>
                    </label>
                    <label><span>Peso</span><input type="text" name="system.inventory.{{it.index}}.weight" value="{{it.weight}}" placeholder="0"></label>
                    <label><span>Valor</span><input type="text" name="system.inventory.{{it.index}}.value" value="{{it.value}}" placeholder="rupias"></label>
                </div>
                <label class="gb-action-desc"><span>Descrição</span><input type="text" name="system.inventory.{{it.index}}.description" value="{{it.description}}"></label>
            </div>
        </div>
        {{else}}
        <p class="gb-empty gb-empty--sm">Nada nesta categoria.</p>
        {{/each}}
    </section>
    {{/each}}
</section>

{{!-- ===================== CLASSE & HERANÇA ===================== --}}
<section class="gb-tab" data-tab-content="identidade">
    <div class="gb-idcards">
        <div class="gb-idcard gb-idcard--class">
            <div class="gb-idcard-head">
                <h3><i class="fa-solid fa-hand-fist"></i> Classe</h3>
                {{#if classItem}}
                <span class="gb-idcard-name">{{classItem.name}}</span>
                <a class="gb-btn gb-btn--hit" data-action="openEmbedded" data-item-id="{{classItem.id}}" title="Abrir"><i class="fa-solid fa-up-right-from-square"></i></a>
                <a class="gb-btn gb-btn--del" data-action="removeEmbedded" data-item-id="{{classItem.id}}" title="Remover"><i class="fa-solid fa-trash"></i></a>
                {{else}}
                <span class="gb-empty-inline">selecione no topo</span>
                {{/if}}
            </div>
            {{#if classItem}}
            <div class="gb-idcard-body">
                <div class="gb-chips">
                    <span class="gb-chip">Vida {{classItem.system.vidaBase}}</span>
                    <span class="gb-chip">Dado {{classItem.system.vidaDado}}</span>
                    <span class="gb-chip">Dano {{classItem.system.danoDado}}</span>
                </div>
                {{#if classItem.system.manaCondition}}<div class="gb-idcard-mana"><i class="fa-solid fa-droplet"></i> {{classItem.system.manaCondition}}</div>{{/if}}
                {{#each classAbilities as |ab|}}
                <div class="gb-mini-ability"><strong>{{ab.name}}</strong> <em>({{ab.type}})</em>{{#if ab.description}}<p>{{ab.description}}</p>{{/if}}</div>
                {{/each}}
            </div>
            {{/if}}
        </div>

        <div class="gb-idcard gb-idcard--heritage">
            <div class="gb-idcard-head">
                <h3><i class="fa-solid fa-dna"></i> Herança</h3>
                {{#if heritageItem}}
                <span class="gb-idcard-name">{{heritageItem.name}}</span>
                <a class="gb-btn gb-btn--hit" data-action="openEmbedded" data-item-id="{{heritageItem.id}}" title="Abrir"><i class="fa-solid fa-up-right-from-square"></i></a>
                <a class="gb-btn gb-btn--del" data-action="removeEmbedded" data-item-id="{{heritageItem.id}}" title="Remover"><i class="fa-solid fa-trash"></i></a>
                {{else}}
                <span class="gb-empty-inline">selecione no topo</span>
                {{/if}}
            </div>
            {{#if heritageItem}}
            <div class="gb-idcard-body">
                {{#each heritageProgress as |p|}}
                <div class="gb-mini-ability"><strong>{{p.name}}</strong>{{#if p.requirement}} <em>({{p.requirement}})</em>{{/if}}{{#if p.description}}<p>{{p.description}}</p>{{/if}}</div>
                {{/each}}
            </div>
            {{/if}}
        </div>
    </div>
</section>

{{!-- ===================== BIOGRAFIA ===================== --}}
<section class="gb-tab" data-tab-content="bio">
    <label class="gb-bio"><span>Atribuições Aparentes</span><textarea name="system.biography.appearance">{{biography.appearance}}</textarea></label>
    <label class="gb-bio"><span>"Inner Demons" e Conflitos</span><textarea name="system.biography.demons">{{biography.demons}}</textarea></label>
    <label class="gb-bio"><span>Metas e Motivações</span><textarea name="system.biography.motivations">{{biography.motivations}}</textarea></label>
    <label class="gb-bio"><span>Worldview</span><textarea name="system.biography.worldview">{{biography.worldview}}</textarea></label>
    <label class="gb-bio"><span>Backstory</span><textarea name="system.biography.backstory">{{biography.backstory}}</textarea></label>
    <label class="gb-bio"><span>Notas</span><textarea name="system.notes">{{notes}}</textarea></label>
</section>
</div>
