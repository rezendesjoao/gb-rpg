{{!-- Ficha de Personagem (Guerreiro Mágico) — Códice Celeste --}}
<div class="gb-sheet gb-sheet--character" data-tooltip-class="gb-tooltip">
    {{!-- ============ Coluna do herói: arte, nome, vitais, defesas e rank ============ --}}
    <aside class="gb-side">
        <figure class="gb-portrait gb-frame">
            <img src="{{actor.img}}" data-action="editImage" data-edit="img" alt="{{actor.name}}" data-tooltip="Clique para trocar a arte">
            <div class="gb-portrait-shade"></div>
            <label class="gb-crest" data-rank="{{rank.letter}}" data-tooltip="Rank de Guerreiro Mágico — clique para trocar">
                <span class="gb-crest-letter">{{rank.letter}}</span>
                <span class="gb-crest-num">{{rank.number}}</span>
                <select name="system.rank">
                    {{#each rankOptions as |o|}}
                    <option value="{{o.value}}" {{#if o.selected}}selected{{/if}}>{{o.label}}</option>
                    {{/each}}
                </select>
            </label>
            <a class="gb-portrait-zoom" data-action="showArtwork" data-tooltip="Ver a arte em tamanho real"><i class="fa-solid fa-expand"></i></a>
            <figcaption class="gb-nameplate">
                <input class="gb-name" type="text" name="name" value="{{actor.name}}" placeholder="Nome do personagem">
                <div class="gb-picks">
                    {{> "systems/granblue/templates/actor/parts/class-heritage-select.hbs"}}
                    <label class="gb-pick gb-pick--level" data-tooltip="Nível">
                        <span class="gb-pick-key">Nv</span>
                        <input class="gb-inline" type="number" name="system.level" value="{{system.level}}" min="0">
                    </label>
                </div>
            </figcaption>
        </figure>

        {{> "systems/granblue/templates/actor/parts/vitals.hbs"}}

        <div class="gb-side-block gb-rankbar" data-rank="{{rank.letter}}">
            <div class="gb-vital-row">
                <span class="gb-vital-label"><i class="fa-solid fa-chart-line"></i> Progresso de Rank</span>
                <span class="gb-vital-nums">
                    <input class="gb-inline" type="number" name="system.progress.current" value="{{progress.current}}" min="0" data-tooltip="Pontos de progresso atuais">
                    <span class="gb-vital-sep">/</span>
                    <input class="gb-inline gb-vital-max" type="number" name="system.progress.final" value="{{progress.final}}" min="0" data-tooltip="Pontos necessários para o próximo rank">
                </span>
            </div>
            <div class="gb-meter"><span style="--pct: {{progressPct}}%"></span></div>
        </div>
    </aside>

    {{!-- ============ Códice: abas ============ --}}
    <div class="gb-main">
        <nav class="gb-tabs">
            <a data-tab-nav="atributos"><i class="fa-solid fa-hand-fist"></i><span>Atributos</span></a>
            <a data-tab-nav="acoes"><i class="fa-solid fa-swords"></i><span>Ações</span></a>
            <a data-tab-nav="magia"><i class="fa-solid fa-book-sparkles"></i><span>Grimório</span></a>
            <a data-tab-nav="inventario"><i class="fa-solid fa-gem"></i><span>Inventário</span></a>
            <a data-tab-nav="identidade"><i class="fa-solid fa-dna"></i><span>Classe &amp; Herança</span></a>
            <a data-tab-nav="bio"><i class="fa-solid fa-feather-pointed"></i><span>Biografia</span></a>
        </nav>

        <div class="gb-body">
            {{!-- ===================== ATRIBUTOS ===================== --}}
            <section class="gb-tab" data-tab-content="atributos">
                {{> "systems/granblue/templates/actor/parts/attributes.hbs"}}
                {{> "systems/granblue/templates/actor/parts/formulas.hbs"}}
            </section>

            {{!-- ===================== AÇÕES ===================== --}}
            <section class="gb-tab" data-tab-content="acoes">
                <header class="gb-section">
                    <h3><i class="fa-solid fa-swords"></i> Técnicas &amp; ataques <em>{{actions.length}}</em></h3>
                    <span class="gb-rule"></span>
                    <div class="gb-tools">
                        <button type="button" class="gb-btn gb-btn--sm" data-action="addAction"><i class="fa-solid fa-plus"></i> Ação</button>
                        <button type="button" class="gb-btn gb-btn--sm" data-action="addAction" data-passive="true"><i class="fa-solid fa-feather"></i> Passiva</button>
                    </div>
                </header>
                <details class="gb-help">
                    <summary><i class="fa-solid fa-circle-info"></i> Como as ações funcionam</summary>
                    <div>
                        Ataques e manobras não-mágicas; as magias ficam no <strong>Grimório</strong>, dentro da esfera delas.
                        A estrela marca o <strong>ataque básico</strong>, rolado pelo HUD ao custo de uma ação normal.
                        Com um token marcado como alvo (tecla <strong>T</strong>), o cartão confere o acerto contra a CA dele.
                        Atalhos nas fórmulas: <code>@forca</code> <code>@precisao</code> <code>@reacao</code> <code>@resiliencia</code>
                        <code>@percepcao</code> <code>@carisma</code> <code>@sabedoria</code> <code>@potencia</code> <code>@disciplina</code>
                        <code>@nivel</code> <code>@ca</code>.
                    </div>
                </details>
                <div class="gb-list">
                    {{#each actions as |action|}}
                    {{> "systems/granblue/templates/actor/parts/action-row.hbs" row=action index=action.index list="actions"}}
                    {{else}}
                    <p class="gb-empty">Nenhuma técnica ainda. Crie uma ação ou uma passiva.</p>
                    {{/each}}
                </div>
            </section>

            {{!-- ===================== GRIMÓRIO ===================== --}}
            <section class="gb-tab" data-tab-content="magia">
                {{> "systems/granblue/templates/actor/parts/magic-tab.hbs"}}
            </section>

            {{!-- ===================== INVENTÁRIO ===================== --}}
            <section class="gb-tab" data-tab-content="inventario">
                {{> "systems/granblue/templates/actor/parts/inventory.hbs"}}
            </section>

            {{!-- ===================== CLASSE & HERANÇA ===================== --}}
            <section class="gb-tab" data-tab-content="identidade">
                {{> "systems/granblue/templates/actor/parts/identity-tab.hbs"}}
            </section>

            {{!-- ===================== BIOGRAFIA ===================== --}}
            <section class="gb-tab" data-tab-content="bio">
                {{> "systems/granblue/templates/actor/parts/biography.hbs"}}
            </section>
        </div>
    </div>
</div>
