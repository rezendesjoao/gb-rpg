{{!-- Cartão de chat das rolagens de loot: chance (d100), quantidade e qualidade --}}
<div class="granblue gb-card gb-card--loot" data-tooltip-class="gb-tooltip">
    <header class="gb-card-head">
        <span class="gb-card-emblem"><i class="fa-solid fa-sack-dollar"></i></span>
        <div class="gb-card-titles">
            {{#if subtitle}}<span class="gb-card-kicker">{{subtitle}}</span>{{/if}}
            <h3 class="gb-card-title">{{title}}</h3>
        </div>
    </header>
    <div class="gb-card-rolls">
        {{> "systems/granblue/templates/chat/parts/roll.hbs" roll subtitle=rollLabel kind="loot"}}
    </div>
    {{#if verdict}}<div class="gb-card-verdict gb-card-verdict--{{verdict}}">{{verdictLabel}}</div>{{/if}}
</div>
