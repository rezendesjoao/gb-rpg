{{!--
    Cartão de rolagem no chat (testes de atributo, dado de vida, ações e magias).
    A magia leva o selo procedural e a cor da esfera; a ação, o emblema do tipo.
--}}
<div class="granblue gb-card gb-card--{{kind}}"{{#if sphere}} data-sphere="{{sphere}}"{{/if}} data-tooltip-class="gb-tooltip">
    <header class="gb-card-head">
        {{#if sigil}}
        <span class="gb-sigil gb-sigil--live gb-card-sigil" data-gb-sigil="1" data-sphere="{{sphere}}" data-sigil-name="{{sigil.name}}" data-sigil-arcano="{{sigil.arcano}}" data-sigil-level="{{sigil.level}}"></span>
        {{else}}
        <span class="gb-card-emblem"><i class="{{icon}}"></i></span>
        {{/if}}
        <div class="gb-card-titles">
            {{#if kicker}}<span class="gb-card-kicker">{{kicker}}</span>{{/if}}
            <h3 class="gb-card-title">{{title}}</h3>
        </div>
    </header>

    {{#if chips.length}}
    <div class="gb-card-chips">
        {{#each chips as |c|}}<span class="gb-card-chip" data-tooltip="{{c.label}}"><i class="{{c.icon}}"></i>{{c.value}}</span>{{/each}}
    </div>
    {{/if}}

    {{#if description}}<blockquote class="gb-card-quote">{{description}}</blockquote>{{/if}}

    {{#if sections.length}}
    <div class="gb-card-rolls">
        {{#each sections as |s|}}
        {{> "systems/granblue/templates/chat/parts/roll.hbs" s}}
        {{/each}}
    </div>
    {{/if}}

    {{#if check}}
    <div class="gb-card-check gb-card-check--{{check.result}}">
        <i class="fa-solid {{#if (eqStr check.result "success")}}fa-wand-magic-sparkles{{else}}fa-heart-crack{{/if}}"></i>
        <span>Conjuração · CD {{check.dc}}</span>
        <strong>{{check.label}}</strong>
    </div>
    {{/if}}

    {{#if targets.length}}
    <div class="gb-card-targets">
        {{#each targets as |t|}}
        <div class="gb-target{{#if t.result}} is-{{t.result}}{{/if}}" data-gb-target="{{t.uuid}}">
            {{#if t.img}}<img class="gb-target-img" src="{{t.img}}" alt="">{{/if}}
            <span class="gb-target-name">{{t.name}}</span>
            {{#if t.caLabel}}<span class="gb-target-ca" data-gb-owner-only>{{t.caLabel}}</span>{{/if}}
            {{#if t.result}}<span class="gb-target-res">{{t.resultLabel}}</span>{{/if}}
            {{#if t.canApply}}
            <span class="gb-target-btns">
                {{#if @root.hasDamage}}
                <button type="button" class="gb-target-btn gb-target-btn--dmg" data-gb-owner-only data-gb-apply="damage" data-amount="{{@root.applyAmount}}" data-damage-type="{{@root.damageType}}" data-tooltip="Aplicar {{@root.applyAmount}} de dano {{@root.damageTypeLabel}} em {{t.name}} (a RD {{@root.damageTypeLabel}} dele é abatida; Shift+clique = dano verdadeiro)"><i class="fa-solid fa-heart-crack"></i></button>
                {{/if}}
                {{#if @root.statusEffect}}
                <button type="button" class="gb-target-btn gb-target-btn--fx" data-gb-apply="effect" data-effect="{{@root.statusEffect.id}}" data-target="{{t.uuid}}" data-tooltip="Aplicar {{@root.statusEffect.label}} em {{t.name}}"><img src="{{@root.statusEffect.img}}" alt=""></button>
                {{/if}}
            </span>
            {{/if}}
        </div>
        {{/each}}
    </div>
    {{/if}}

    {{#if effectText}}
    <div class="gb-card-effect">
        <span class="gb-card-label"><i class="fa-solid fa-sparkles"></i> Efeito</span>
        <p>{{effectText}}</p>
    </div>
    {{/if}}
    {{#if statusEffect}}
    <div class="gb-card-status">
        <img src="{{statusEffect.img}}" alt="">
        <div>
            <strong>{{statusEffect.label}}</strong>
            {{#if statusEffect.description}}<p>{{statusEffect.description}}</p>{{/if}}
        </div>
    </div>
    {{/if}}

    {{#if hasButtons}}
    <footer class="gb-card-actions">
        {{#if hasRolls}}
        <button type="button" class="gb-apply gb-apply--dmg" data-gb-apply="damage" data-amount="{{applyAmount}}" data-damage-type="{{damageType}}"
                data-tooltip="Aplicar dano {{damageTypeLabel}} nos tokens selecionados (sem seleção: nos alvos atingidos). A RD {{damageTypeLabel}} de cada um é abatida — Shift+clique aplica dano verdadeiro, ignorando a RD.">
            <i class="fa-solid fa-heart-crack"></i> Dano <b>{{applyAmount}}</b>{{#if hasDamage}} <small>{{damageTypeLabel}}</small>{{/if}}
        </button>
        <button type="button" class="gb-apply gb-apply--heal" data-gb-apply="heal" data-amount="{{applyAmount}}" data-tooltip="Curar os tokens selecionados (sem seleção: os alvos da rolagem)">
            <i class="fa-solid fa-heart"></i> Cura <b>{{applyAmount}}</b>
        </button>
        {{/if}}
        {{#if statusEffect}}
        <button type="button" class="gb-apply gb-apply--fx" data-gb-apply="effect" data-effect="{{statusEffect.id}}" data-tooltip="Aplicar {{statusEffect.label}} nos tokens selecionados (sem seleção: nos alvos atingidos)">
            <img src="{{statusEffect.img}}" alt=""> {{statusEffect.label}}
        </button>
        {{/if}}
    </footer>
    {{/if}}
</div>
