{{!-- Cartão de rolagem no chat --}}
<div class="granblue gb-chat-card">
    <header class="gb-chat-header">
        <h3>{{title}}</h3>
    </header>

    {{#if description}}<div class="gb-chat-desc">{{description}}</div>{{/if}}

    {{#each sections as |s|}}
    <div class="gb-chat-section">
        {{#if s.subtitle}}<div class="gb-chat-subtitle">{{s.subtitle}}</div>{{/if}}
        {{> "systems/granblue/templates/chat/parts/roll.hbs" s}}
    </div>
    {{/each}}

    {{#if check}}
    <div class="gb-chat-check gb-chat-check--{{check.result}}">
        <i class="fa-solid fa-wand-magic-sparkles"></i> Conjuração · CD {{check.dc}}: <strong>{{check.label}}</strong>
    </div>
    {{/if}}

    {{#if targets.length}}
    <div class="gb-chat-targets">
        {{#each targets as |t|}}
        <div class="gb-target" data-gb-target="{{t.uuid}}">
            {{#if t.img}}<img class="gb-target-img" src="{{t.img}}" alt="">{{/if}}
            <span class="gb-target-name">{{t.name}}</span>
            {{#if t.caLabel}}<span class="gb-target-ca" data-gb-owner-only>{{t.caLabel}}</span>{{/if}}
            {{#if t.result}}<span class="gb-target-res gb-target-res--{{t.result}}">{{t.resultLabel}}</span>{{/if}}
            {{#if t.canApply}}
            <span class="gb-target-btns">
                {{#if @root.hasDamage}}
                <button type="button" class="gb-target-btn gb-target-btn--dmg" data-gb-owner-only data-gb-apply="damage" data-amount="{{@root.applyAmount}}" data-damage-type="{{@root.damageType}}" data-target="{{t.uuid}}" title="Aplicar {{@root.applyAmount}} de dano {{@root.damageTypeLabel}} em {{t.name}} (a RD {{@root.damageTypeLabel}} dele é abatida; Shift+clique = dano verdadeiro)"><i class="fa-solid fa-heart-crack"></i></button>
                {{/if}}
                {{#if @root.statusEffect}}
                <button type="button" class="gb-target-btn gb-target-btn--fx" data-gb-apply="effect" data-effect="{{@root.statusEffect.id}}" data-target="{{t.uuid}}" title="Aplicar {{@root.statusEffect.label}} em {{t.name}}"><img class="gb-apply-icn" src="{{@root.statusEffect.img}}" alt=""></button>
                {{/if}}
            </span>
            {{/if}}
        </div>
        {{/each}}
    </div>
    {{/if}}

    {{#if meta}}
    <ul class="gb-chat-meta">
        {{#each meta as |m|}}<li><strong>{{m.label}}:</strong> {{m.value}}</li>{{/each}}
    </ul>
    {{/if}}

    {{#if effectText}}<div class="gb-chat-effect"><strong>Efeito:</strong> {{effectText}}</div>{{/if}}
    {{#if statusEffect}}
    <div class="gb-chat-status">
        <img class="gb-chat-status-icn" src="{{statusEffect.img}}" alt="">
        <span><strong>{{statusEffect.label}}</strong>{{#if statusEffect.description}}: {{statusEffect.description}}{{/if}}</span>
    </div>
    {{/if}}

    <div class="gb-chat-apply">
        {{#if hasRolls}}
        <button type="button" class="gb-apply gb-apply--dmg" data-gb-apply="damage" data-amount="{{applyAmount}}" data-damage-type="{{damageType}}" title="Aplicar dano {{damageTypeLabel}} nos tokens selecionados (sem seleção: nos alvos atingidos). A RD {{damageTypeLabel}} de cada um é abatida — Shift+clique aplica dano verdadeiro, ignorando a RD.">
            <i class="fa-solid fa-heart-crack"></i> Dano {{applyAmount}}{{#if hasDamage}} <small class="gb-dmg-type">{{damageTypeLabel}}</small>{{/if}}
        </button>
        <button type="button" class="gb-apply gb-apply--heal" data-gb-apply="heal" data-amount="{{applyAmount}}" title="Curar os tokens selecionados (sem seleção: os alvos da rolagem)">
            <i class="fa-solid fa-heart"></i> Cura {{applyAmount}}
        </button>
        {{/if}}
        {{#if statusEffect}}
        <button type="button" class="gb-apply gb-apply--fx" data-gb-apply="effect" data-effect="{{statusEffect.id}}" title="Aplicar {{statusEffect.label}} nos tokens selecionados (sem seleção: nos alvos atingidos)">
            <img class="gb-apply-icn" src="{{statusEffect.img}}" alt=""> {{statusEffect.label}}
        </button>
        {{/if}}
    </div>
</div>
