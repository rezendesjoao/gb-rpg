{{!-- Cartão de rolagem no chat --}}
<div class="granblue gb-chat-card">
    <header class="gb-chat-header">
        <h3>{{title}}</h3>
    </header>

    {{#each sections as |s|}}
    <div class="gb-chat-section">
        {{#if s.subtitle}}<div class="gb-chat-subtitle">{{s.subtitle}}</div>{{/if}}
        <div class="gb-chat-roll">{{{s.rollHTML}}}</div>
        {{#if s.difficulties}}
        <div class="gb-chat-ladder">
            {{#each s.difficulties as |d|}}
            <span class="gb-dc {{#if d.success}}gb-dc--met{{else}}gb-dc--unmet{{/if}}" title="{{d.label}}">{{d.label}}: {{d.value}}</span>
            {{/each}}
        </div>
        {{/if}}
    </div>
    {{/each}}

    {{#if meta}}
    <ul class="gb-chat-meta">
        {{#each meta as |m|}}<li><strong>{{m.label}}:</strong> {{m.value}}</li>{{/each}}
    </ul>
    {{/if}}
</div>
