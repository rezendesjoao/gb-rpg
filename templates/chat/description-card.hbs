{{!--
    Cartão de descrição no chat: habilidade passiva, habilidade de classe, traço
    de herança, item do inventário, vantagem/desvantagem do adversário. A
    passiva de uma magia leva o selo dela.
--}}
<div class="granblue gb-card gb-card--text{{#if kind}} gb-card--{{kind}}{{/if}}"{{#if sphere}} data-sphere="{{sphere}}"{{/if}} data-tooltip-class="gb-tooltip">
    <header class="gb-card-head">
        {{#if sigil}}
        <span class="gb-sigil gb-sigil--live gb-card-sigil" data-gb-sigil="1" data-sphere="{{sphere}}" data-sigil-name="{{sigil.name}}" data-sigil-arcano="{{sigil.arcano}}" data-sigil-level="{{sigil.level}}"></span>
        {{else}}
        <span class="gb-card-emblem"><i class="{{#if icon}}{{icon}}{{else}}fa-solid fa-feather{{/if}}"></i></span>
        {{/if}}
        <div class="gb-card-titles">
            {{#if subtitle}}<span class="gb-card-kicker">{{subtitle}}</span>{{/if}}
            <h3 class="gb-card-title">{{title}}</h3>
        </div>
    </header>
    <div class="gb-card-text">
        {{#if body}}{{{body}}}{{else}}<p class="gb-card-muted">Sem descrição.</p>{{/if}}
    </div>
</div>
